{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "RedSana",
  "version": "0.1.8",
  "identifier": "com.redsana.desktop",
  "build": {
    "frontendDist": "../dist/frontend/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "npm start",
    "beforeBuildCommand": "npm run build && node scripts/prepare-desktop-build.mjs"
  },
  "app": {
    "windows": [
      {
        "title": "RedSana",
        "url": "index.csr.html",
        "width": 1200,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,IntensiveWakeUpThrottling,CalculateNativeWinOcclusion --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data: https://kvnhnobjtwqirndmukts.supabase.co",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost https://redsana-api.onrender.com https://kvnhnobjtwqirndmukts.supabase.co https://redsana-ai-engine.onrender.com",
        "worker-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
