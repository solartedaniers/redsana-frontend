{
  "iconBackground": "#0a0e11",
  "sources": {
    "full": "redsana-symbol.png",
    "compact": "redsana-symbol-compact.png"
  },
  "compactMaxSize": 48,
  "paddingRatio": 0.08,
  "maskablePaddingRatio": 0.14,
  "pwa": {
    "directory": "../public/icons",
    "publicRoot": "../public",
    "sizes": [72, 96, 128, 144, 152, 192, 384, 512],
    "maskableSizes": [192, 512],
    "appleTouchSize": 180,
    "manifest": "../public/manifest.webmanifest"
  },
  "favicon": {
    "path": "../public/favicon.ico",
    "sizes": [16, 32, 48]
  },
  "brandMark": {
    "path": "../public/assets/branding/brand-mark.png",
    "size": 96,
    "variant": "compact",
    "paddingRatio": 0.12
  },
  "tauri": {
    "iconsDirectory": "../src-tauri/icons",
    "cliSourceSize": 1024,
    "generatedEntriesToDiscard": ["android", "ios", "64x64.png"],
    "ico": {
      "file": "icon.ico",
      "sizes": [16, 24, 32, 48, 64, 256]
    }
  },
  "theme": {
    "tokensFile": "../src/styles/_tokens.scss",
    "selector": ":root[data-theme='dark']",
    "token": "--color-bg-app",
    "manifest": "../public/manifest.webmanifest",
    "indexHtml": "../src/index.html"
  }
}
