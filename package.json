{
  "name": "frontend",
  "version": "0.1.9",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "prebuild": "node scripts/generate-environment.mjs && node scripts/generate-seo-files.mjs && node scripts/sync-theme-color.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "pretest": "node scripts/generate-environment.mjs && node --test scripts/brand-colors.test.mjs scripts/brand-assets.test.mjs scripts/i18n-legend.test.mjs scripts/i18n-recommendation-how.test.mjs scripts/i18n-diagnosis.test.mjs scripts/i18n-score-weights.test.mjs scripts/diagnosis-parity.test.mjs scripts/route-names.test.mjs scripts/seo-files.test.mjs",
    "test": "ng test",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/animations": "^22.2.3",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-server": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@angular/service-worker": "^22.2.3",
    "@angular/ssr": "^22.2.3",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@supabase/supabase-js": "^2.116.0",
    "@tauri-apps/api": "^2.11.1",
    "rxjs": "~7.8.0",
    "three": "^0.186.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "~4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/three": "^0.186.0",
    "angular-eslint": "22.6.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.12.0",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.28",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^4.0.8"
  }
}
