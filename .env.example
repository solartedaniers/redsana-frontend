# Copia este archivo a .env (gitignorado) para builds locales como tauri build.
# En Vercel se definen las mismas variables en Project Settings > Environment Variables.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
API_BASE_URL=https://redsana-api.onrender.com
# Página "latest" de GitHub Releases: siempre lleva a la última versión publicada,
# sin depender del nombre del instalador.
DESKTOP_DOWNLOAD_URL=https://github.com/solartedaniers/redsana-frontend/releases/latest
# Direct installer download: the app asks GitHub's public API for the latest
# release of this repo and picks the asset whose name ends with the suffix.
# DESKTOP_DOWNLOAD_URL above stays as the fallback when that lookup fails.
# Optional (these are the defaults).
GITHUB_API_URL=https://api.github.com
DESKTOP_RELEASE_REPO=solartedaniers/redsana-frontend
DESKTOP_INSTALLER_ASSET_SUFFIX=-setup.exe
# URL pública de la web. El correo de recuperación de contraseña pedido desde el
# escritorio (Tauri) enlaza aquí, porque el origen interno de Tauri no se abre en un navegador.
WEB_APP_URL=https://red-sana.vercel.app
