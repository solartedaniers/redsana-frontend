# Copia este archivo a .env (gitignorado) para builds locales como tauri build.
# En Vercel se definen las mismas variables en Project Settings > Environment Variables.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
API_BASE_URL=https://redsana-api.onrender.com
# Página "latest" de GitHub Releases: siempre lleva a la última versión publicada,
# sin depender del nombre del instalador.
DESKTOP_DOWNLOAD_URL=https://github.com/solartedaniers/RedSana/releases/latest
# URL pública de la web. El correo de recuperación de contraseña pedido desde el
# escritorio (Tauri) enlaza aquí, porque el origen interno de Tauri no se abre en un navegador.
WEB_APP_URL=https://red-sana.vercel.app
