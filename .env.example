# Copia este archivo a .env (gitignorado) para builds locales como tauri build.
# En Vercel se definen las mismas variables en Project Settings > Environment Variables.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
API_BASE_URL=https://redsana-api.onrender.com
# Enlace del botón "Descargar": el instalador con nombre fijo del último release. GitHub redirige
# .../releases/latest/download/<nombre> al asset de la versión más nueva, así que no cambia en cada versión.
# Cada Release debe llevar ese asset (ver "Publicar una versión" en el README). Si no termina en .exe, el build falla.
DESKTOP_DOWNLOAD_URL=https://github.com/solartedaniers/redsana-frontend/releases/latest/download/RedSana_x64-setup.exe
# URL pública de la web. El correo de recuperación de contraseña pedido desde el
# escritorio (Tauri) enlaza aquí, porque el origen interno de Tauri no se abre en un navegador.
# También es el dominio de la URL canónica, de Open Graph y Twitter Card, de robots.txt y de sitemap.xml:
# cambiar de dominio es cambiar solo esta variable (y volver a desplegar).
WEB_APP_URL=https://www.app-redsana.com
# Opcional: URL pública del servicio de IA. Al iniciar o restaurar la sesión, abrir el chat o reintentar,
# la app le hace un GET silencioso a /health para despertarlo (se suma al calentamiento del backend).
# Vacía o sin definir, no se hace.
AI_SERVICE_PUBLIC_URL=https://redsana-ai-engine.onrender.com
# Credenciales de ejemplo precargadas en el login (requisito académico, no es seguro):
# con DEMO_LOGIN_ENABLED=true el correo y la contraseña quedan dentro del JavaScript publicado,
# así que solo deben ser los de una cuenta de demostración. Apagado y vacío por defecto.
DEMO_LOGIN_ENABLED=false
DEMO_LOGIN_EMAIL=
DEMO_LOGIN_PASSWORD=
